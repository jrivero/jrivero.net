---
interface GridItem {
  label: string;
  title: string;
  description: string;
}

interface Props {
  items: GridItem[];
}

const { items } = Astro.props;
---

<section class="py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => (
        <div class="glow-card hover:-translate-y-0.5">
          <p class="text-xs text-[var(--text-tertiary)] tracking-wider uppercase mb-2">{item.label}</p>
          <h4 class="text-xl font-bold tracking-tight mb-3">{item.title}</h4>
          <p class="text-sm text-[var(--text-tertiary)] leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
  <div class="section-divider mt-16"></div>
</section>