---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const allPosts = await getCollection("posts");
---

<BaseLayout
  title="Technical Archive"
  description="Deep dives técnicos y tesis de inversión."
>
  <div class="mb-16">
    <p class="text-xs text-[var(--text-tertiary)] tracking-wider uppercase mb-3">Archive</p>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight">Blog</h1>
    <p class="text-[var(--text-tertiary)] mt-3 max-w-xl">
      Exploration of technology, strategy and capital flow.
    </p>
  </div>

  {
    allPosts.length === 0 && (
      <div class="text-center py-12">
        <h2 class="text-2xl font-bold">No posts found</h2>
        <p class="text-[var(--text-tertiary)] mt-4">Check back later for new content.</p>
      </div>
    )
  }

  <div class="grid grid-cols-1 gap-4">
    {
      allPosts
        .sort(
          (a, b) =>
            new Date(b.data.pubDate).getTime() -
            new Date(a.data.pubDate).getTime(),
        )
        .map((post) => (
          <a
            href={`/posts/${post.id}/`}
            class="glow-card flex flex-col md:flex-row md:items-center justify-between no-underline hover:-translate-y-0.5"
          >
            <div class="flex flex-col">
              <p class="text-xs text-[var(--text-tertiary)] tracking-wider uppercase mb-1">{post.id}</p>
              <h2 class="text-xl font-semibold tracking-tight text-[var(--text-primary)]">
                {post.data.title}
              </h2>
            </div>
            <div class="mt-4 md:mt-0 text-right">
              <span class="text-xs text-[var(--text-tertiary)]">
                {new Date(post.data.pubDate).toLocaleDateString("es-ES", {
                  year: "numeric",
                  month: "2-digit",
                  day: "2-digit",
                })}
              </span>
            </div>
          </a>
        ))
    }
  </div>
</BaseLayout>